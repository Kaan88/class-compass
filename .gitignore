# Dependencies & builds
node_modules/
dist/
build/
.next/
coverage/
playwright-report/
# Visual baseline report (npm run test:visual, S26a); the baselines themselves are in e2e/visual-baselines/
playwright-report-visual/
test-results/
# Usability screenshot sets (npm run usability:screens) — never committed
usability-shots/
# Avatar review sheets (e2e/avatar-sheets.spec.ts) — kept outside test-results/, never committed
review-sheets/
blob-report/
*.tsbuildinfo

# Secrets & local config — never commit
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# Real data — never commit (student records, uploads, DBs, backups)
data/
uploads/
storage/
backups/
*.db
*.sqlite
*.sqlite3
*.dump
*.sql.gz
*.bak

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
*.log

# Deployment secrets (S11, D-017/D-018) — examples end in .example
app.env
tunnel.env
deploy/*.env
data-test/
*.db-wal
*.db-shm

# Agent worktrees (parallel stage runs)
.claude/worktrees/
