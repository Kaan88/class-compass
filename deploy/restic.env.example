# Off-site backups with restic (D-017). Copy to deploy/restic.env (chmod 600, owner classcompass,
# never commit). The app passes only these variables (plus PATH/HOME) to restic and never logs them.
#
# Choose ONE repository.
#
# Cloudflare R2 (S3 API; create an R2 API token with Object Read & Write on this bucket only):
#RESTIC_REPOSITORY=s3:https://<account-id>.r2.cloudflarestorage.com/<bucket>
#AWS_ACCESS_KEY_ID=<r2-access-key-id>
#AWS_SECRET_ACCESS_KEY=<r2-secret-access-key>
#
# Backblaze B2 (an application key restricted to this bucket):
#RESTIC_REPOSITORY=b2:<bucket>:class-compass
#B2_ACCOUNT_ID=<application-key-id>
#B2_ACCOUNT_KEY=<application-key>
#
# Repository password. Keep a copy OFF the server (e.g. the school's password manager):
# without it the off-site backups cannot be read.
RESTIC_PASSWORD=
# or: RESTIC_PASSWORD_FILE=/run/secrets/restic-password
#
# Off-site retention (restic forget --prune after each upload).
OFFSITE_KEEP_DAILY=30
OFFSITE_KEEP_WEEKLY=8
OFFSITE_KEEP_MONTHLY=12
