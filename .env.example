# Copy to .env for local development. NEVER commit real values.
NODE_ENV=development
PORT=3210
HOST=127.0.0.1
# Directory holding the SQLite DB, uploads and local backups (gitignored)
DATA_DIR=./data
# 32+ random bytes, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SECRET_PEPPER=change-me-generate-a-random-value
# Public origin used for CSRF/Origin checks and student links
PUBLIC_ORIGIN=http://localhost:5173
# Trust CF-Connecting-IP / X-Forwarded-For only when behind Cloudflare Tunnel (D-018)
TRUST_PROXY=false
DEFAULT_TIMEZONE=Europe/Istanbul
# Optional SMTP (D-015). Email password reset is enabled only when SMTP_HOST is set.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Upload quotas in MB (per student, whole server) and the local OCR time limit per image (ms)
UPLOAD_STUDENT_QUOTA_MB=100
UPLOAD_GLOBAL_QUOTA_MB=10240
OCR_TIMEOUT_MS=90000
# Workbook, Word and PDF parsing time limit per file (ms, worker thread)
PARSE_TIMEOUT_MS=30000
# Optional OCR language data folder (default DATA_DIR/ocr-cache). Leave it commented out in app.env
# for Docker: the image bakes the data into /opt/class-compass/ocr and an empty value would hide that.
# OCR_CACHE_DIR=
# Local backups (S11, D-089): folder (default DATA_DIR/backups) and retention counts
BACKUP_DIR=
BACKUP_KEEP_HOURLY=48
BACKUP_KEEP_DAILY=30
BACKUP_KEEP_MONTHLY=12
# Off-site copy (restic, D-017): retention and when the Maintenance page warns (hours)
OFFSITE_KEEP_DAILY=30
OFFSITE_KEEP_WEEKLY=8
OFFSITE_KEEP_MONTHLY=12
OFFSITE_STALE_HOURS=36
# Shown as the app version (+commit) on the Maintenance page; set by the Docker build
APP_COMMIT=
