{
  "name": "class-compass",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Class Compass – primary-school classroom management",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "node --run dev:server & node --run dev:client",
    "dev:server": "node --watch --env-file-if-exists=.env src/server/main.ts",
    "dev:client": "vite",
    "build": "vite build",
    "start": "node src/server/main.ts",
    "cli": "node --env-file-if-exists=.env src/server/cli.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env src/server/cli.ts migrate",
    "seed:demo": "node --env-file-if-exists=.env src/server/cli.ts seed:demo",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "node --run typecheck && node --run lint && node --run test"
  },
  "dependencies": {
    "@date-fns/tz": "1.5.0",
    "@fastify/cookie": "11.1.5",
    "@fastify/helmet": "13.2.0",
    "@fastify/multipart": "10.1.8",
    "@fastify/rate-limit": "11.2.2",
    "@fastify/static": "10.1.10",
    "@node-rs/argon2": "2.2.2",
    "@tanstack/react-query": "5.107.1",
    "@tanstack/react-router": "1.170.46",
    "better-sqlite3": "13.0.3",
    "date-fns": "4.4.0",
    "dexie": "4.4.7",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.8",
    "fastify-type-provider-zod": "7.0.0",
    "pino": "10.4.0",
    "react": "19.3.1",
    "react-aria-components": "1.22.1",
    "react-dom": "19.3.1",
    "uuid": "14.0.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@tailwindcss/vite": "4.3.5",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "drizzle-kit": "0.31.11",
    "eslint": "10.14.0",
    "eslint-plugin-boundaries": "7.4.2",
    "fast-check": "4.10.2",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
